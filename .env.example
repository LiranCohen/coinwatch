# Backend (server/): copy to .env and fill in real values. Never commit .env.

# Bitcoin node RPC (KTD-4)
BITCOIND_RPC_URL=http://127.0.0.1:8332
BITCOIND_RPC_USER=your-rpc-user
BITCOIND_RPC_PASSWORD=your-rpc-password

# Detection
POLL_INTERVAL_MS=5000
WHALE_THRESHOLD_BTC=10
DORMANT_BLOCKS=4320
DORMANT_MIN_VALUE_BTC=1
COINJOIN_MIN_EQUAL_OUTPUTS=5

# Address lookups (fallback chain) (R4)
MEMPOOL_API=https://mempool.space/api
BLOCKSTREAM_API=https://blockstream.info/api

# AI provider (OpenAI-compatible). Unset → mock provider.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Dev injector (demo events). Loopback-only when enabled (R17).
INJECTOR_ENABLED=false

PORT=3001
SEED_FILE=server/fixtures/seed-labels.json

# Frontend (web/): serve all reads from web/fixtures/ with zero backend
VITE_USE_FIXTURES=false
