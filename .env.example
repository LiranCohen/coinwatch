# bitcoind RPC endpoint (KTD-4)
BITCOIND_RPC_URL=http://127.0.0.1:8332
BITCOIND_RPC_USER=your-rpc-user
BITCOIND_RPC_PASSWORD=your-rpc-password

# mempool diff cadence in ms (KTD-4)
POLL_INTERVAL_MS=5000

# detection rule thresholds (R2, KTD-5)
WHALE_THRESHOLD_BTC=10
DORMANT_BLOCKS=4320
DORMANT_MIN_VALUE_BTC=1
COINJOIN_MIN_EQUAL_OUTPUTS=5

# address lookups: primary + fallback (R4)
MEMPOOL_API=https://mempool.space/api
BLOCKSTREAM_API=https://blockstream.info/api

# AI provider; unset selects the mock provider (KTD-6)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# dev-only demo injector; 404 unless true (R17)
INJECTOR_ENABLED=false

# HTTP listen port
PORT=3001

# TagPacks seed subset imported on first startup (KTD-8)
SEED_FILE=server/fixtures/seed-labels.json
